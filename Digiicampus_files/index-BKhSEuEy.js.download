      border-radius: ${e.borderRadius}px !important;
      border: 2px solid ${e.colorFillTertiary} !important;
      min-height: 30px !important;
    }
    ${n} .ant-table-body::-webkit-scrollbar-thumb:hover,
    ${n} .ant-table-content::-webkit-scrollbar-thumb:hover {
      background: ${e.colorTextSecondary} !important;
      border-color: ${e.colorFillSecondary} !important;
    }
    ${n} .ant-table-body::-webkit-scrollbar-corner,
    ${n} .ant-table-content::-webkit-scrollbar-corner {
