    .ProseMirror {
      outline: none !important;
      background: transparent !important;
      min-height: 240px;
      padding: 0 !important;
    }
    .tiptap-variant-compact .ProseMirror {
      min-height: var(${mRt}, ${Que}px) !important;
    }
    .ProseMirror:focus {
      outline: none !important;
    }
    .ProseMirror .is-editor-empty::before,
    .ProseMirror p.is-editor-empty:first-child::before {
      content: attr(data-placeholder);
      float: left;
      color: ${e.colorTextPlaceholder};
      pointer-events: none;
      height: 0;
    }
    .ProseMirror blockquote {
      border-left: 3px solid ${e.colorBorder};
      margin: 0.5em 0;
      padding: 0.25em 0 0.25em 1em;
      color: ${e.colorTextSecondary};
      font-style: italic;
    }
    .ProseMirror ul,
    .ProseMirror ol {
      padding-left: 1.5em !important;
      margin-left: 0 !important;
    }
    .ProseMirror ul {
      list-style-type: disc;
    }
    .ProseMirror ol {
      list-style-type: decimal;
    }
    .ProseMirror li {
      display: list-item;
      padding-left: 0.25em;
    }
    .ProseMirror li p {
      margin: 0;
    }
    .ProseMirror table {
      border-collapse: collapse;
      table-layout: fixed;
      width: 100%;
      margin: 0;
      overflow: hidden;
    }
    .ProseMirror td,
    .ProseMirror th {
      min-width: 1em;
      border: 1px solid ${e.colorBorder};
      padding: 6px 8px;
      vertical-align: top;
      box-sizing: border-box;
      position: relative;
    }
    .ProseMirror th {
      font-weight: bold;
      text-align: left;
      background-color: ${e.colorFillSecondary};
    }
    .ProseMirror .selectedCell:after {
      z-index: 2;
      position: absolute;
      content: "";
      left: 0; right: 0; top: 0; bottom: 0;
      background: ${e.colorPrimaryBg};
      pointer-events: none;
    }
    .ProseMirror .column-resize-handle {
      position: absolute;
      right: -2px;
      top: 0;
      bottom: -2px;
      width: 4px;
      background-color: ${e.colorPrimary};
      pointer-events: none;
    }
    .ProseMirror.resize-cursor {
      cursor: col-resize;
    }
