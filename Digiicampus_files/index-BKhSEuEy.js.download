// Simple button upload
<MediaUpload
  variant="button"
  feature="YOUR_FEATURE"
  onUploadSuccess={(files) => console.log('Uploaded:', files)}
  onUploadError={(error) => console.error('Error:', error)}
/>

// Drag & drop with restrictions
<MediaUpload
  variant="dragger"
  multiple={true}
