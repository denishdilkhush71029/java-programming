    @keyframes addMultipleOfflinePaymentsFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes addMultipleOfflinePaymentsSlideIn {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    body.add-multiple-offline-payments-sidebar-open {
      overflow: hidden;
      position: fixed;
      width: 100%;
    }
    .add-multiple-offline-payments-sidebar-content {
      scrollbar-width: thin;
      scrollbar-color: ${n} ${s};
    }
    .add-multiple-offline-payments-sidebar-content::-webkit-scrollbar {
      width: 6px;
    }
    .add-multiple-offline-payments-sidebar-content::-webkit-scrollbar-track {
      background: ${s};
      border-radius: 10px;
    }
    .add-multiple-offline-payments-sidebar-content::-webkit-scrollbar-thumb {
      background: ${n};
      border-radius: 10px;
    }
    .add-multiple-offline-payments-sidebar-content::-webkit-scrollbar-thumb:hover {
      background: ${i};
    }
    .add-multiple-offline-payments-sidebar-table-wrapper {
      scrollbar-width: thin;
      scrollbar-color: ${n} ${s};
    }
    .add-multiple-offline-payments-sidebar-table-wrapper::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .add-multiple-offline-payments-sidebar-table-wrapper::-webkit-scrollbar-track {
      background: ${s};
      border-radius: 10px;
    }
    .add-multiple-offline-payments-sidebar-table-wrapper::-webkit-scrollbar-thumb {
      background: ${n};
      border-radius: 10px;
    }
    .add-multiple-offline-payments-sidebar-table-wrapper::-webkit-scrollbar-thumb:hover {
      background: ${i};
    }
    .add-multiple-offline-payments-sidebar-table tbody tr:hover td {
      background-color: ${a} !important;
    }
    .add-multiple-offline-payments-sidebar-table tbody tr:last-child td {
      border-bottom: none;
    }
    @media (max-width: 768px) {
      .add-multiple-offline-payments-sidebar-container {
        width: 100% !important;
        min-width: 100% !important;
