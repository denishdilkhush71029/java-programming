    .fc .fc-toolbar { display: none !important; }
    .fc .fc-col-header-cell { background: ${f.colorFillAlter}; height: 48px; vertical-align: middle; }
    .fc .fc-col-header-cell-cushion { color: ${f.colorTextSecondary}; font-size: ${f.fontSize}px; font-weight: ${f.fontWeightStrong}; text-decoration: none; padding: 14px 4px; display: block; }
    .fc .fc-timegrid-slot { font-size: ${f.fontSizeSM}px; height: 3.8em; }
    .fc .fc-event-title { font-size: ${f.fontSizeSM}px; font-weight: 600; }
    .fc .fc-event-time  { font-size: 11px; }
    .fc .fc-scrollgrid { border-color: ${f.colorBorderSecondary}; }
    .fc td, .fc th { border-color: ${f.colorBorderSecondary}; }
    /* Preserve each event's own colour on hover / focus / click. FullCalendar
       v6 paints a ::before overlay on selected events (and the antd primary
       theme leaks through that overlay), which made every clicked event read
       as a primary-red tint. Kill the overlay and replace hover with a pure
       brightness filter so green stays green, blue stays blue, etc. */
    .fc .fc-event { transition: filter 0.15s ease; }
    .fc .fc-event:hover { filter: brightness(0.92); }
    .fc .fc-event:focus,
    .fc .fc-event:active,
    .fc .fc-event.fc-event-selected,
    .fc .fc-event.fc-event-dragging {
      outline: none !important;
      box-shadow: none !important;
      filter: brightness(0.92);
    }
    .fc .fc-event::before,
    .fc .fc-event::after,
    .fc .fc-event-selected::before,
    .fc .fc-event-selected::after {
      content: none !important;
      background: none !important;
      box-shadow: none !important;
      opacity: 0 !important;
    }
    .fc .fc-event:not(.solver-calendar-break-event) .fc-event-main,
    .fc .fc-event:not(.solver-calendar-break-event).fc-h-event .fc-event-main,
    .fc .fc-event:not(.solver-calendar-break-event).fc-v-event .fc-event-main {
      background: transparent !important;
      color: #fff !important;
    }
    .fc .fc-event.solver-calendar-break-event .fc-event-main {
      background: transparent !important;
      color: inherit !important;
    }
