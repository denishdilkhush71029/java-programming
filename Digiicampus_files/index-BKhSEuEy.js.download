    /*
     * ReusableTable uses .responsive-table-container with default display: block.
     * Inside a flex host, min-height: auto lets that wrapper grow to full table height while the
     * host uses overflow: hidden — clipping rows. Match PhD dashboard (phdStyles.css): only this
     * wrapper joins the flex chain; do not flex the inner .ant-table / .ant-table-container or the
     * fixed header can collapse and disappear.
     */
    ${n} .responsive-table-container {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    ${n} .ant-table-body,
    ${n} .ant-table-content {
      scrollbar-width: thin !important;
      scrollbar-color: ${e.colorTextTertiary} transparent !important;
    }
    ${n} .ant-table-body::-webkit-scrollbar,
    ${n} .ant-table-content::-webkit-scrollbar {
      width: 8px !important;
      height: 8px !important;
    }
    ${n} .ant-table-body::-webkit-scrollbar-track,
    ${n} .ant-table-content::-webkit-scrollbar-track {
      background: ${e.colorFillTertiary} !important;
      border-radius: ${e.borderRadius}px !important;
      margin: ${e.marginXS}px 0 !important;
    }
    ${n} .ant-table-body::-webkit-scrollbar-thumb,
    ${n} .ant-table-content::-webkit-scrollbar-thumb {
