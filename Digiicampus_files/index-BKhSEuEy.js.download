      box-shadow: 0 0 0 2px ${e.colorPrimaryBg};
    }
    .latex-tab-button:hover:not(.latex-tab-button-active) {
      color: ${e.colorText} !important;
      background: ${e.colorFillSecondary} !important;
    }
    .latex-tab-button-active {
      color: ${e.colorPrimary} !important;
      border-bottom-color: ${e.colorPrimary} !important;
      background: ${e.colorBgContainer} !important;
    }
    .latex-tab-button-active:hover {
      background: ${e.colorBgContainer} !important;
    }
    .mathlive-toolbar-btn:hover {
      background: ${e.colorFillSecondary} !important;
    }
    .mathlive-toolbar-btn[data-active='true'] {
      background: ${e.colorFill} !important;
      color: ${e.colorPrimary} !important;
    }
    .latex-draggable-modal .ant-modal-content {
      padding: 0 !important;
      overflow: hidden;
    }
    .latex-draggable-modal .ant-modal-header {
      display: none;
    }
    .latex-draggable-modal .ant-modal-body {
      padding: 0 !important;
    }
    .latex-draggable-modal .ant-modal-close {
      display: none;
    }
